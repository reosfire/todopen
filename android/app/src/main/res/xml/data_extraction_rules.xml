<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for API 31+.

    See backup_rules.xml: backup is disabled via android:allowBackup="false",
    and these exclusions keep the Dropbox OAuth tokens out of both cloud
    backup and direct device-to-device transfer regardless.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
