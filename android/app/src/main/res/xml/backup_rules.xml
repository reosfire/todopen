<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 24-30.

    Backup is disabled outright via android:allowBackup="false", so these
    rules are belt-and-braces: if backup is ever re-enabled, the Dropbox
    OAuth tokens must still never leave the device. A refresh token copied
    into Google Drive and restored onto another device would hand that
    device full access to the user's app folder.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
